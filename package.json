{
  "name": "antdv-pro-layout",
  "version": "3.2.6",
  "description": "Ant Design Pro Layout of Vue, easy to use pro scaffolding.",
  "keywords": [
    "Ant Design Vue",
    "antdv",
    "pro-layout",
    "antdv-pro"
  ],
  "contributors": [
    "TsMask <340112800@qq.com>"
  ],
  "repository": {
    "type": "git",

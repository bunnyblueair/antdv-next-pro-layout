  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "ant-design-vue": ">=3.2.0 <4.0.0",
    "vue": ">=3.2.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist",
  "style": "./dist/style.css",
  "main": "./dist/antdv-pro-layout.umd.js",
  "umd": "./dist/antdv-pro-layout.umd.js",
  "module": "./dist/antdv-pro-layout.mjs",

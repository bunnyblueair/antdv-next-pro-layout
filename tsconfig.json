{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsxImportSource": "vue",
    "outDir": "dist",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/*": ["./playground/*"],
      "antdv-pro-layout": ["./src/index.ts"]
    }
  },
  "exclude": ["dist","node_modules"],
  "include": [
    "playground/**/*.ts",
    "playground/**/*.tsx",
    "playground/**/*.vue",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vite-env.d.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
